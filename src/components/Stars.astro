---
interface Props { n: number; label: string }
const { n, label } = Astro.props;
---
<span class="stars" role="img" aria-label={label}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill={i < n ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="m12 3 2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z" /></svg>
  ))}
</span>
